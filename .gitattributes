# Normalize line endings for text sources; keep CAD artifacts binary.
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.csv   text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

*.step  binary
*.stp   binary
*.stl   binary
*.png   binary
*.jpg   binary
